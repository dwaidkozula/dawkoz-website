# Offline first. No paid requests in demo mode.
BOT_MODE=demo
ALLOW_LIVE_CALLS=false
LIVE_TEST_ONLY=true
ALLOWED_CALLERS=
PUBLIC_BASE_URL=
PORT=3001
CLIENT_CONFIG=config/client.json
# Railway: paste one client configuration here instead of committing client.json.
CLIENT_CONFIG_JSON=
DATA_DIR=./data
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
